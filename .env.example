# Copy to .env.local and adjust. All variables are optional.

# Override the SQLite database location
# FINANCE_DB_PATH=/absolute/path/to/sqlite.db

# Local Ollama server for the monthly insight card.
# Must be a loopback URL. Balances are sent only to this address.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
